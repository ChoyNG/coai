{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
    }
  },
  "include": [
    "src",
    "*.ts",
  ],
  /* vite.config.ts belongs to the referenced composite project
     tsconfig.node.json; including it here too makes `tsc` fail with TS6305
     (output file vite.config.d.ts has not been built from source file). */
  "exclude": ["vite.config.ts"],
  "baseUrl": ".",
  "references": [{ "path": "./tsconfig.node.json" }],
}
